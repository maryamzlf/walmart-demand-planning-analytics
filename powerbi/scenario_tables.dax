-- Reference parameter tables matching the business-facing names in the final report.
-- Create these as disconnected tables with Modeling > New table.

ScenarioLeadTime =
SELECTCOLUMNS (
    GENERATESERIES ( 7, 28, 1 ),
    "Lead Time (Days)", [Value]
)

ScenarioReviewPeriod =
DATATABLE (
    "Review Period (Days)", INTEGER,
    {
        { 0 }, { 7 }, { 14 }, { 21 }, { 28 }
    }
)

ScenarioServiceLevel =
DATATABLE (
    "Service Level", STRING,
    "Z", DOUBLE,
    {
        { "ABC default", BLANK() },
        { "85%", 1.036 },
        { "90%", 1.282 },
        { "95%", 1.645 },
        { "97%", 1.881 },
        { "99%", 2.326 }
    }
)
