-- Reference DAX matching the canonical compiled Power BI semantic model.
-- Business-facing column names below are the names exposed in the final report.

-- PlannerActionCenter measures
Forecast Units 28D =
SUM ( PlannerActionCenter[Forecast (28D)] )

Prior Units 28D =
SUM ( PlannerActionCenter[Prior (28D)] )

Forecast Unit Change =
[Forecast Units 28D] - [Prior Units 28D]

Forecast Growth % =
DIVIDE ( [Forecast Unit Change], [Prior Units 28D] )

Revenue 365D =
SUM ( PlannerActionCenter[Revenue ($, 365D)] )

Units 365D =
SUM ( PlannerActionCenter[Units (365D)] )

Item-Store Count =
DISTINCTCOUNT ( PlannerActionCenter[item_store_key] )

Average Risk Score =
AVERAGE ( PlannerActionCenter[Risk Score] )

High-Risk Item-Store Count =
CALCULATE (
    [Item-Store Count],
    KEEPFILTERS ( PlannerActionCenter[Risk Score] >= 70 )
)

High-Risk Revenue =
CALCULATE (
    [Revenue 365D],
    KEEPFILTERS ( PlannerActionCenter[Risk Score] >= 70 )
)

High-Risk Revenue Share =
DIVIDE ( [High-Risk Revenue], [Revenue 365D] )

A-Class Revenue =
CALCULATE (
    [Revenue 365D],
    REMOVEFILTERS ( PlannerActionCenter[ABC Class] ),
    PlannerActionCenter[ABC Class] = "A"
)

A-Class Revenue Share =
DIVIDE (
    [A-Class Revenue],
    CALCULATE (
        [Revenue 365D],
        REMOVEFILTERS ( PlannerActionCenter[ABC Class] )
    )
)

Growth Review Count =
CALCULATE (
    [Item-Store Count],
    KEEPFILTERS ( PlannerActionCenter[Planning Change %] >= 20 )
)

Decline Review Count =
CALCULATE (
    [Item-Store Count],
    KEEPFILTERS ( PlannerActionCenter[Planning Change %] <= -20 )
)

Planning Change Signal % =
DIVIDE ( AVERAGE ( PlannerActionCenter[Planning Change %] ), 100 )

Baseline Safety Stock Units =
SUM ( PlannerActionCenter[Baseline Safety Stock] )

Baseline Reorder Point Units =
SUM ( PlannerActionCenter[Baseline Reorder Point] )

Baseline Target Stock Units =
SUM ( PlannerActionCenter[Baseline Target Stock] )

Scenario Lead Time Days =
SELECTEDVALUE ( ScenarioLeadTime[Lead Time (Days)], 14 )

Scenario Review Period Days =
SELECTEDVALUE ( ScenarioReviewPeriod[Review Period (Days)], 7 )

Scenario Service Label =
SELECTEDVALUE ( ScenarioServiceLevel[Service Level], "ABC default" )

Scenario Z Override =
SELECTEDVALUE ( ScenarioServiceLevel[Z] )

Scenario Safety Stock Units =
VAR LeadTime = [Scenario Lead Time Days]
VAR ScenarioLabel = [Scenario Service Label]
VAR OverrideZ = [Scenario Z Override]
RETURN
IF (
    LeadTime = 14 && ScenarioLabel = "ABC default",
    [Baseline Safety Stock Units],
    SUMX (
        PlannerActionCenter,
        VAR ClassZ =
            SWITCH (
                PlannerActionCenter[ABC Class],
                "A", 1.645,
                "B", 1.282,
                "C", 1.036,
                1.282
            )
        VAR ZValue = IF ( ScenarioLabel = "ABC default", ClassZ, OverrideZ )
        RETURN
            ZValue
                * PlannerActionCenter[Demand Sigma 90D]
                * SQRT ( LeadTime )
    )
)

Scenario Reorder Point Units =
VAR LeadTime = [Scenario Lead Time Days]
VAR ScenarioLabel = [Scenario Service Label]
VAR OverrideZ = [Scenario Z Override]
RETURN
IF (
    LeadTime = 14 && ScenarioLabel = "ABC default",
    [Baseline Reorder Point Units],
    SUMX (
        PlannerActionCenter,
        VAR ClassZ =
            SWITCH (
                PlannerActionCenter[ABC Class],
                "A", 1.645,
                "B", 1.282,
                "C", 1.036,
                1.282
            )
        VAR ZValue = IF ( ScenarioLabel = "ABC default", ClassZ, OverrideZ )
        VAR Safety =
            ZValue
                * PlannerActionCenter[Demand Sigma 90D]
                * SQRT ( LeadTime )
        RETURN
            PlannerActionCenter[Avg Daily Forecast] * LeadTime + Safety
    )
)

Scenario Target Stock Units =
VAR LeadTime = [Scenario Lead Time Days]
VAR ReviewDays = [Scenario Review Period Days]
VAR ScenarioLabel = [Scenario Service Label]
VAR OverrideZ = [Scenario Z Override]
RETURN
IF (
    LeadTime = 14
        && ReviewDays = 7
        && ScenarioLabel = "ABC default",
    [Baseline Target Stock Units],
    SUMX (
        PlannerActionCenter,
        VAR ClassZ =
            SWITCH (
                PlannerActionCenter[ABC Class],
                "A", 1.645,
                "B", 1.282,
                "C", 1.036,
                1.282
            )
        VAR ZValue = IF ( ScenarioLabel = "ABC default", ClassZ, OverrideZ )
        VAR Safety =
            ZValue
                * PlannerActionCenter[Demand Sigma 90D]
                * SQRT ( LeadTime )
        RETURN
            PlannerActionCenter[Avg Daily Forecast]
                * ( LeadTime + ReviewDays )
                + Safety
    )
)

Scenario Safety Stock Delta =
[Scenario Safety Stock Units] - [Baseline Safety Stock Units]

Scenario Target Stock Delta =
[Scenario Target Stock Units] - [Baseline Target Stock Units]

Scenario Target Stock Delta % =
DIVIDE ( [Scenario Target Stock Delta], [Baseline Target Stock Units] )

-- PriorityModelHoldout measures
Priority LightGBM WAPE =
CALCULATE (
    MAX ( PriorityModelHoldout[wape] ),
    PriorityModelHoldout[Model] = "LightGBM"
)

Priority MA28 WAPE =
CALCULATE (
    MAX ( PriorityModelHoldout[wape] ),
    PriorityModelHoldout[Model] = "MA28"
)

Priority WAPE Improvement % =
DIVIDE (
    [Priority MA28 WAPE] - [Priority LightGBM WAPE],
    [Priority MA28 WAPE]
)

Priority LightGBM Bias % =
CALCULATE (
    MAX ( PriorityModelHoldout[bias_pct] ),
    PriorityModelHoldout[Model] = "LightGBM"
)

Model WAPE =
MAX ( PriorityModelHoldout[wape] )

-- BaselineModelSummary measures
Baseline WAPE =
AVERAGE ( BaselineModelSummary[avg_wape] )

Baseline RMSE =
AVERAGE ( BaselineModelSummary[avg_rmse] )

Baseline Bias % =
AVERAGE ( BaselineModelSummary[avg_bias_pct] )

-- ForecastWeekly measure
Weekly Forecast Units =
SUM ( ForecastWeekly[Forecast Units] )

-- FeatureImportance measure
Feature Importance Share =
SUM ( FeatureImportance[share] )
